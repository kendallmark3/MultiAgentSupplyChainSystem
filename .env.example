# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Autonomous Supply Chain — Environment Configuration
# Run: sh setup.sh   (or copy this to .env and fill in)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── GCP Project (Vision Agent — Vertex AI / Gemini) ──
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ── Gemini API Key (for Vision Agent) ────────────────
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ── Supplier Agent — ChromaDB (local, no credentials needed) ──
# Path to ChromaDB persistent storage (default: database/chroma_db)
# Leave blank to use the default location.
CHROMA_DB_PATH=

# Embedding model (default: all-MiniLM-L6-v2, downloads ~80MB on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Google OAuth (MCP Integrations) ──────────────────
# Required for Gmail, Calendar, and Sheets confirmations.
# See README.md → MCP Setup for instructions.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=

# ── MCP Targets (your accounts, not the original author's) ──
# Email address that receives order confirmations and calendar events
MCP_USER_EMAIL=your-email@gmail.com
# Google Sheets order log (create a blank sheet, paste its ID here)
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_URL=
